# =============================================================================
# Variables d'environnement
# En local : copier ce fichier en `.env.local` puis remplir les valeurs.
# Sur Vercel : Project > Settings > Environment Variables (mêmes noms).
# Ne JAMAIS committer `.env.local` (il est ignoré par git).
# =============================================================================

# --- Supabase ---------------------------------------------------------------
# Supabase > Project Settings > Data API (ou API) > Project URL
# Exemple : https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase > Project Settings > API Keys > clé `anon` / `publishable` (publique).
# Utilisée dans le navigateur de l'admin pour envoyer les fichiers via des
# URLs d'upload signées. Seule, elle ne donne accès à rien (voir supabase/schema.sql).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase > Project Settings > API Keys > clé `service_role` / `secret`.
# SECRÈTE : accès total à la base et au stockage. Utilisée uniquement côté
# serveur (jamais de préfixe NEXT_PUBLIC_, jamais dans le navigateur).
SUPABASE_SERVICE_ROLE_KEY=

# --- Administration ---------------------------------------------------------
# Mot de passe unique de la page /admin. Choisir une longue phrase de passe
# (16 caractères minimum). Le changer déconnecte toutes les sessions ouvertes.
ADMIN_PASSWORD=

# --- Optionnel --------------------------------------------------------------
# URL publique du site, sans slash final. Sert aux liens absolus des aperçus
# (WhatsApp, LinkedIn, mail) et au bouton « copier le lien ».
# Si vide : domaine de production Vercel, puis http://localhost:3000.
# Exemple : https://catalogues.mondomaine.fr
NEXT_PUBLIC_SITE_URL=

# Secret du cron quotidien qui garde le projet Supabase actif (le plan gratuit
# met en pause un projet inactif 7 jours). Une chaîne aléatoire suffit, ex. :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
